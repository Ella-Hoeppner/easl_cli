(defn sympow [x: f32
              power: f32]: f32
  (* (sign x) (pow (abs x) power)))

(def TAU: f32
     6.28318530718)

(var phase: f32)

(var filter: f32)

(defn osc [x: f32]: f32
  (-> x (* TAU) sin))

@audio
(defn audio []: f32
  (= phase
     (-> phase
         (+ (* 220
               (/ (sample-rate))
               (pow 1.01
                    (osc (* (audio-time) 9.)))))
         (% 1.)))
  (let [raw-sample (* (sympow (osc (+ phase
                                      (* 0.5
                                         (osc (+ 0.25 (* 3 phase))))))
                              0.2)
                      (-> (osc (audio-time))
                          (+ 1)
                          (* 0.5)
                          (mix 0.25 1. <>)))]
    (= filter
       (mix filter raw-sample 0.1))
    filter))

@cpu
(defn main []
  (start-audio audio)
  (spawn-window (fn [] ())))

