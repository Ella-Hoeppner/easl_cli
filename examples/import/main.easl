(import "color.easl")

@vertex
(defn vertex []: vec4f
  (vec4f (let [a [(vec2f -1.)
                  (vec2f -1. 3.)
                  (vec2f 3. -1.)]]
           (a (vertex-index)))
         0.
         1.))

@fragment
(defn fragment []: vec4f
  (vec4f color 1.))

@cpu
(defn main []
  (spawn-window (fn []
                    (dispatch-render-shaders vertex fragment 3))))

